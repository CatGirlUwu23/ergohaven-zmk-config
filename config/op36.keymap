#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <125>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        kha {
            bindings = <&kp RU_CYRILLIC_HA>;
            key-positions = <6 7>;
        };

        hrdsgn {
            bindings = <&kp RU_CYRILLIC_HARD_SIGN>;
            key-positions = <7 8>;
        };
    };

    macros {
        mail: mail {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp A &kp R &kp G &kp A &kp R &kp E &kp T &kp DOT &kp O &kp R &kp O &kp B &kp E &kp T &kp S &kp AT &kp G &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M>;
            label = "MAIL";
        };

        test_heart: test_heart {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LCTRL &kp LSHIFT &kp U &kp N2 &kp N6 &kp N6 &kp N1 &kp SPACE>;
        };

        kaomoji_hug: kaomoji_hug {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            bindings = <&kp LC(LS(U)) &kp N2 &kp E &kp N1 &kp C &kp SPACE &kp LPAR &kp LC(LS(U)) &kp F &kp F &kp N6 &kp N1 &kp SPACE &kp LC(LS(U)) &kp N0 &kp N2 &kp C &kp N3 &kp SPACE &kp SPACE &kp LC(LS(U)) &kp N1 &kp D &kp N5 &kp N5 &kp SPACE &kp SPACE &kp LC(LS(U)) &kp N0 &kp N2 &kp C &kp N2 &kp SPACE &kp RPAR &kp LC(LS(U)) &kp N2 &kp E &kp N1 &kp D &kp SPACE &kp LC(LS(U)) &kp N2 &kp N6 &kp N6 &kp N1 &kp SPACE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
  &kp Q  &kp W  &kp E  &kp R           &kp T                                  &kp Y   &kp U          &kp I  &kp O  &kp P
  &kp A  &kp S  &kp D  &kp F           &kp G                                  &kp H   &kp J          &kp K  &kp L  &none
  &kp Z  &kp X  &kp C  &kp V           &kp B                                  &kp N   &kp M          &none  &none  &none
                       &kp LEFT_SHIFT  &tog 1  &kp SPACE    &kp LEFT_CONTROL  &tog 2  &kp BACKSPACE
            >;

            display-name = "Base";
        };

        nav {
            bindings = <
  &kp CAPSLOCK          &kp LEFT_ALT           &kp DELETE        &kp TAB         &kp ENTER                                        &kp GRAVE          &mkp LCLK       &mkp MCLK       &mkp RCLK        &kp LEFT_GUI
  &kp LEFT_CONTROL      &kp LEFT_SHIFT         &kp LEFT          &kp UP          &kp RIGHT_ARROW                                  &kp DOUBLE_QUOTES  &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_RIGHT  &kp SEMICOLON
  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp DOWN_ARROW  &kp RIGHT_BRACKET                                &kp APOSTROPHE     &msc SCRL_UP    &mmv MOVE_DOWN  &msc SCRL_DOWN   &kp COLON
                                                                 &kp LEFT_BRACE  &tog 1             &kp RIGHT_BRACE    &kp COMMA  &mo 3              &kp PERIOD
            >;

            display-name = "Nav";
        };

        sym {
            bindings = <
  &kp LESS_THAN         &kp GREATER_THAN  &kp POUND   &kp RU_NUMERO    &kp CARET                            &kp PERCENT   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp EQUAL
  &kp NON_US_BACKSLASH  &kp SLASH         &kp PIPE    &kp UNDERSCORE   &kaomoji_hug                         &kp ASTERISK  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PLUS
  &kp TILDE             &kp AMPERSAND     &kp DOLLAR  &kp AT_SIGN      &test_heart                          &none         &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp MINUS
                                                      &kp EXCLAMATION  &mo 3         &kp QUESTION    &mail  &tog 2        &kp KP_NUMBER_0
            >;

            display-name = "Symbols";
        };

        adj {
            bindings = <
  &bootloader  &kp F1  &kp F2   &kp F3   &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1         &bt BT_SEL 2       &bt BT_SEL 3        &bt BT_CLR
  &kp LGUI     &kp F5  &kp F6   &kp F7   &kp F8                     &out OUT_BLE  &hmr RCTRL C_VOL_DN  &hmr RSHFT C_MUTE  &hmr LALT C_VOL_UP  &kp RGUI
  &none        &kp F9  &kp F10  &kp F11  &kp F12                    &out OUT_USB  &kp C_PREV           &kp C_PP           &kp C_NEXT          &studio_unlock
                                &trans   &trans   &trans    &trans  &trans        &trans
            >;

            display-name = "Adjust";
        };
    };
};
