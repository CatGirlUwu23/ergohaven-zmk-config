#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define HOST_OS 1

#include "zmk-helpers/helper.h"
#include "zmk-helpers/unicode-chars/german.dtsi"

&mt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <125>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };
    };

    macros {
        mail: mail {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp A &kp R &kp G &kp A &kp R &kp E &kp T &kp DOT &kp O &kp R &kp O &kp B &kp E &kp T &kp S &kp AT &kp G &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M>;
            label = "MAIL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
  &kp Q  &kp W  &kp E  &kp R           &kp T                                 &kp Y          &kp U       &kp I      &kp O       &kp P
  &kp A  &kp S  &kp D  &kp F           &kp G                                 &kp H          &kp J       &kp K      &kp L       &kp SEMICOLON
  &kp Z  &kp X  &kp C  &kp V           &kp B                                 &kp N          &kp M       &kp COMMA  &kp PERIOD  &kp SLASH
                       &kp LEFT_SHIFT  &mo 1  &kp SPACE    &kp LEFT_CONTROL  &kp RIGHT_ALT  &kp DELETE
            >;

            display-name = "Base";
        };

        nav {
            bindings = <
  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5                              &kp NUMBER_7  &mkp LCLK       &mkp MCLK       &mkp RCLK        &kp LEFT_GUI
  &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_N0                                    &kp NUMBER_8  &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_RIGHT  &kp KP_COMMA
  &kp NUMBER_1     &kp NUMBER_2     &kp NUMBER_3     &kp NUMBER_4     &kp NUMBER_5                                 &kp NUMBER_9  &msc SCRL_UP    &mmv MOVE_DOWN  &msc SCRL_DOWN   &kp KP_EQUAL
                                                     &kp NUMBER_5     &mo 1            &kp NUMBER_6    &kp KP_DOT  &mo 2         &mail
            >;

            display-name = "Nav";
        };

        adj {
            bindings = <
  &bootloader  &kp F1  &kp F2   &kp F3   &kp F4                   &bt BT_SEL 0  &bt BT_SEL 1         &bt BT_SEL 2       &bt BT_SEL 3        &bt BT_CLR
  &kp LGUI     &kp F5  &kp F6   &kp F7   &kp F8                   &out OUT_BLE  &hmr RCTRL C_VOL_DN  &hmr RSHFT C_MUTE  &hmr LALT C_VOL_UP  &kp RGUI
  &none        &kp F9  &kp F10  &kp F11  &kp F12                  &out OUT_USB  &kp C_PREV           &kp C_PP           &kp C_NEXT          &studio_unlock
                                &none    &none    &none    &none  &none         &none
            >;

            display-name = "Adjust";
        };
    };
};
